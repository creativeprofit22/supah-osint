{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"]
  },
  "include": ["packages", "apps", "features", "tests"],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/.hutch",
    "tests/fixtures",
    "apps/desktop/src/bun",
    "apps/desktop/src/mainview",
    "apps/desktop/scripts",
    "apps/desktop/*.config.ts",
    "apps/desktop/dist",
    "apps/desktop/build"
  ]
}
