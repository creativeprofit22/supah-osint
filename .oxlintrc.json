{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "tests/fixtures/**",
    "node_modules/**",
    "**/.hutch/**",
    "**/dist/**",
    "**/build/**",
    "**/artifacts/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "error"
  }
}
